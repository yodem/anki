# ────────────────────────────────────────────────────────────────────────────
# Anki Flashcard Generator — Environment Variables
# Copy this file to .env and fill in the values you need.
# ────────────────────────────────────────────────────────────────────────────

# ── Provider selection ────────────────────────────────────────────────────────
# Which card-generation backend to use.
# Options: gemini (default) | claude | mock
# - gemini : baked-in Google Gemini SDK; requires GOOGLE_API_KEY
# - claude : headless `claude` CLI using your Claude subscription; no API key needed
# - mock   : deterministic offline provider; ideal for tests and dry-runs
CARD_PROVIDER=gemini

# ── Dry-run mode ──────────────────────────────────────────────────────────────
# When true, cards are generated (and cached) but never written to AnkiConnect.
# Useful for previewing output without touching your Anki database.
DRY_RUN=false

# ── Gemini provider settings ─────────────────────────────────────────────────
# Required when CARD_PROVIDER=gemini.
# Either GOOGLE_API_KEY or GEMINI_API_KEY is accepted (GOOGLE_API_KEY takes precedence).
GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here   # alternative to GOOGLE_API_KEY

# Gemini model to use (default: gemini-2.5-pro).
GEMINI_MODEL=gemini-2.5-pro

# ── Claude provider settings ─────────────────────────────────────────────────
# Used when CARD_PROVIDER=claude.
# NO API key is required — the provider calls the `claude` CLI using
# your existing Claude subscription (claude.ai).

# Path to the `claude` CLI binary. If it's on your PATH you can leave this blank.
# CLAUDE_BIN=claude

# Optional model override (e.g. claude-opus-4-5). Leave blank to use the CLI default.
# CLAUDE_MODEL=

# Per-request timeout in milliseconds (default: 180000 = 3 minutes).
# CLAUDE_TIMEOUT_MS=180000

# ── AnkiConnect settings ──────────────────────────────────────────────────────
# AnkiConnect addon must be installed and Anki must be running.
ANKI_CONNECT_URL=http://127.0.0.1:8765

# ── Document settings ─────────────────────────────────────────────────────────
# Directory containing the source text files (default: ./docs).
DOCS_DIR=./docs

# Default parent deck in Anki. Subdecks are created automatically under this.
PARENT_DECK=פילוסופיה פוליטית

# ── Legacy proxy (deprecated) ─────────────────────────────────────────────────
# The old HTTP proxy path is kept for back-compat only.
# The default `gemini` provider does NOT use this — it calls the Gemini SDK directly.
# Only set this if you are intentionally using the deprecated proxy path.
# GEMINI_PROXY_URL=http://localhost:4000
